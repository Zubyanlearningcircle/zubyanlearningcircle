# Razorpay Configuration
# Get these from https://razorpay.com/dashboard/settings/api-keys

RAZORPAY_KEY_ID=your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Payment Configuration
PAYMENT_AMOUNT=1000  # Amount in paise (1000 = ₹10)
PAYMENT_CURRENCY=INR

# Download Token Configuration
TOKEN_EXPIRATION_HOURS=24  # Token validity in hours
MAX_DOWNLOADS_PER_TOKEN=unlimited  # Set a number to limit downloads

# Logging
LOG_PAYMENTS=true
LOG_DOWNLOADS=true
